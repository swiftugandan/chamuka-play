# ── The game agent ("Mishi") ────────────────────────────────────────────────
# One setting picks the model, as a "provider/model" slug (AI Gateway naming).
# Default: anthropic/claude-sonnet-5.5. Stronger: anthropic/claude-opus-5.5.
AGENT_MODEL=
# Claude's thinking effort for the agent: low | medium (default) | high | xhigh | max
AGENT_EFFORT=

# How the model is reached (first match wins for the slug's provider):
#   ANTHROPIC_API_KEY set and the slug is anthropic/*  → Anthropic API directly
#   GOOGLE_GENERATIVE_AI_API_KEY set and slug is google/* → Gemini directly
#   otherwise → Vercel AI Gateway (OIDC on Vercel; AI_GATEWAY_API_KEY locally)
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
AI_GATEWAY_API_KEY=

# Small model for the "Need an idea?" chips (default anthropic/claude-haiku-5.5).
EXAMPLES_MODEL=

# ── Real-browser playtests (Vercel Sandbox) ─────────────────────────────────
# Run `npm run playtest:snapshot` once and paste the id here. When set, Mishi
# plays every game in headless Chromium inside an isolated Vercel Sandbox VM
# (errors, frame rate, blank screens, phone layout + a screenshot it looks at).
# Unset → a fast compile-only check instead. On Vercel the sandbox SDK uses
# OIDC; elsewhere set VERCEL_TOKEN + VERCEL_TEAM_ID + VERCEL_PROJECT_ID.
PLAYTEST_SNAPSHOT_ID=
# Force the compile-only check even when a snapshot is configured.
PLAYTEST=

# ── Offline ─────────────────────────────────────────────────────────────────
# MOCK_AI=1 needs no key: a scripted offline agent plans, builds, tests and
# changes a real playable demo game, so the whole studio works locally.
MOCK_AI=
